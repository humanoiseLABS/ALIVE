<?xml version="1.0" encoding="utf-8"?>
<!-- ALIVE shell: one content frame, one nav bar.
     Do not reorder or insert children into tabContent from XML: MainActivity
     addresses its tabs positionally (0 = home, 1 = quest, 2 = profile, and
     any overlay is appended at 3). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_canvas"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/tabContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- The bar shares the page's own field, so there is no rule between them;
         the selected key lifts into a circle above the strip. -->
    <com.projectego.app.ui.AliveNavBar
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
