<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card: one tile field with the same 22dp corner as every other
     field. No edge and no shadow - a field is seen by being a different colour
     from the ground, and the ground here is the wallpaper.

     A drawable rather than a painted bitmap, because the launcher stretches
     whatever it is given to the widget's real size: a shape's corner stays the
     corner it was drawn as at every size, while a bitmap's corner stretches
     with the picture. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/flat_tile" />
    <corners android:radius="@dimen/radius_field" />
</shape>
