<?xml version="1.0" encoding="utf-8"?>
<!-- The allowance's empty track: the day that is still there to spend, as one
     mint field. The slices themselves are painted by ALIVE and laid over this,
     because a launcher cannot load our font and a bar that changes shape every
     day cannot be a fixed drawable. No edge and no frame - the field is the
     shape. Mint rather than tile because a white track on a white card is not
     a track at all; this is the colour the approved sheet gives the remainder. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/alive_soft_forest" />
    <corners android:radius="@dimen/radius_field" />
</shape>
