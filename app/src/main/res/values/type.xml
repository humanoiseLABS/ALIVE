<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ALIVE typography: two voices, and only two things they each say.

           space_grotesk (semibold + bold) -> what a screen is called and what
              it is worth: mission titles, card titles, section names, the
              sentence a card leads with, the wordmark, and every figure
              (Timer, Number, ScoreValue). The flat design puts the display and
              the numbers in one heavy geometric voice, so the pixel face that
              used to hold the wordmark and the big figures retired into it.
              It holds a heading's authority at small sizes without becoming a
              stamp.

           manrope (regular / medium / bold) -> everything that has to be
              read: body, descriptions and form fields at 400, buttons,
              navigation, chart labels and the small grey lines at 500, and the
              reason a session failed at 700. Open apertures and a plain
              silhouette, so a sentence reads as prose rather than as the same
              quirk Space Grotesk brings to a heading.

         Every style kills the platform font padding and sets its own line
         spacing, because a grotesque and a humanist sans disagree about
         metrics: includeFontPadding=false is what keeps a mixed row (a 28sp
         figure beside a 14sp unit) on one baseline, and lineSpacingExtra is
         the only leading they get. letterSpacing stays 0 everywhere.

         The ladder steps 34 / 24 / 20 / 18 / 16 / 14 / 10, figures run 56 /
         28, and nothing sits two steps apart by less than 2sp. -->

    <!-- ============ DISPLAY AND FIGURES: Space Grotesk 700 ============

         The pixel voice retired with the flat redesign. What it was for - one
         heavy geometric face for the wordmark and for every number - is what
         Space Grotesk 700 does, and it is the face the approved renders were
         drawn with. `Number` and `ScoreValue` inherit `Timer` and move with it. -->

    <style name="TextAppearance.ALIVE.Display" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textColor">@color/flat_ink</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">-2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- A note, not a paragraph: the character's own line, one step down from
         the Lead. It moves to the body voice rather than the display voice, so
         the critter's line reads as a sentence and not as a headline. -->
    <style name="TextAppearance.ALIVE.Annotation" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ALIVE.Timer" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textColor">@color/flat_ink</item>
        <item name="android:textSize">56sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- A ledger number: the same face as the hero, one step down. -->
    <style name="TextAppearance.ALIVE.Number" parent="TextAppearance.ALIVE.Timer">
        <item name="android:textSize">28sp</item>
    </style>

    <!-- The Arcade card's chip figure: a ledger number at chip scale. -->
    <style name="TextAppearance.ALIVE.ScoreValue" parent="TextAppearance.ALIVE.Timer">
        <item name="android:textSize">28sp</item>
    </style>

    <!-- The four score labels on the Arcade card, 12sp: large enough to read on
         the phone without competing with the figure. -->
    <style name="TextAppearance.ALIVE.ScoreLabel" parent="TextAppearance.ALIVE.Meta">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textColor">@color/flat_ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- The closed board's word. The open day's figure is 56sp; at 28sp TUTUP
         read as half a score, so the word takes the hero weight at the largest
         size the widest locale ("CLOSED") allows on a 320dp card. -->
    <style name="TextAppearance.ALIVE.ScoreStatus" parent="TextAppearance.ALIVE.Timer">
        <item name="android:textSize">40sp</item>
    </style>

    <!-- ============ WHAT A SCREEN IS CALLED: SPACE GROTESK ============ -->

    <!-- The one sentence a card leads with. -->
    <style name="TextAppearance.ALIVE.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textColor">@color/flat_ink</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Mission titles and in-flight statements: what Statement and QuestRowTitle
         used to be, at one size instead of two that were indistinguishable. -->
    <style name="TextAppearance.ALIVE.Lead" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textColor">@color/flat_ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Card titles and section names: 16sp semibold, so a card's name is
         louder than the prose under it without competing with a Lead. -->
    <style name="TextAppearance.ALIVE.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/space_grotesk_semibold</item>
        <item name="android:textColor">@color/flat_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ============ EVERYTHING THAT IS READ: MANROPE ============ -->

    <style name="TextAppearance.ALIVE.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textColor">@color/flat_ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Support lines, disclosures, secondary prose. Same size as Body on purpose:
         it is the same kind of thing, said quieter. It replaces BodySecondary and
         quietText, and it is ink_secondary rather than ink_muted because these are
         real sentences and ink_muted sits under 4.5:1 on the canvas. -->
    <style name="TextAppearance.ALIVE.Note" parent="TextAppearance.ALIVE.Body">
        <item name="android:textColor">@color/alive_ink_secondary</item>
    </style>

    <!-- The small grey line beside a tile: "24 quests", "2 routes", and the
         unit that rides the baseline of a figure. -->
    <style name="TextAppearance.ALIVE.Meta" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- The card's context line: the scoreboard's unit and total. Small enough
         that "MENIT DARI 200" still rides the figure's baseline. -->
    <style name="TextAppearance.ALIVE.MetaTiny" parent="TextAppearance.ALIVE.Meta">
        <item name="android:textSize">10sp</item>
        <item name="android:lineSpacingExtra">1sp</item>
    </style>

    <!-- The card's support sentence, ticket copy and closed line: one step up
         from MetaTiny so they read on the phone, not just in the mockup. -->
    <style name="TextAppearance.ALIVE.MetaSmall" parent="TextAppearance.ALIVE.Meta">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">1sp</item>
    </style>

    <!-- The verdict of a failed session, said once, in the heaviest voice the app
         owns. One 700 per card is the rule: it is what lets the sentence under it
         stay quiet instead of shouting back. -->
    <style name="TextAppearance.ALIVE.Error" parent="TextAppearance.ALIVE.Body">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textColor">@color/flat_ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <!-- Why it failed. Ink, because it is a fact and not comfort, but one step
         under the verdict it sits below: two lines of the same weight on one
         card is a card with no hierarchy at all. -->
    <style name="TextAppearance.ALIVE.Reason" parent="TextAppearance.ALIVE.Body">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textColor">@color/flat_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <!-- ============ BADGES: THE ACCENT, AND ITS LIMIT ============ -->

    <!-- Two lines, not one: the minute badge beside the hero figure is
         "min\nleft", and a single-line cap here silently cut the word that
         made it mean anything. -->
    <style name="TextAppearance.ALIVE.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
    </style>

    <!-- ============ FORM ============ -->

    <!-- The Body size, in the reading voice. -->
    <style name="TextAppearance.ALIVE.Option" parent="TextAppearance.ALIVE.Body">
        <item name="android:textColor">@color/flat_ink</item>
    </style>

    <style name="TextAppearance.ALIVE.Input" parent="TextAppearance.ALIVE.Option">
        <item name="android:textColor">@color/flat_ink</item>
        <item name="android:textColorHint">@color/alive_ink_disabled</item>
    </style>

    <!-- ============ ACTIONS ============ -->

    <!-- 16sp medium: heavy enough to read as an offer rather than a caption,
         and the lightest thing a button may be. -->
    <style name="TextAppearance.ALIVE.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- The theme's default button. ALIVE's own buttons are AppCompat over
         hard-shadow drawables and set their own appearance; this exists so any
         Material control inherits the same voice instead of the platform one. -->
    <style name="Widget.ALIVE.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/alive_amber_action</item>
        <item name="android:textColor">@color/flat_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/radius_tile</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/alive_ink_ripple</item>
    </style>

    <!-- ============ NAVIGATION ============ -->

    <!-- Permanent navigation: it cannot be skipped by scrolling past, so it
         gets the reading voice at a weight that survives a glance. -->
    <style name="TextAppearance.ALIVE.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
