<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ALIVE spacing scale. Everything is on a 4dp grid and in dp/sp so the
         values mean what they say; the old code passed raw pixels to
         setPadding(), which made spacing density-dependent. -->

    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">12dp</dimen>
    <dimen name="space_l">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_xxl">32dp</dimen>
    <dimen name="space_xxxl">48dp</dimen>

    <!-- Page gutters: generous whitespace is part of the design. -->
    <dimen name="screen_h_padding">28dp</dimen>
    <dimen name="screen_top_padding">40dp</dimen>
    <dimen name="screen_bottom_padding">56dp</dimen>

    <!-- Rhythm: one value per relationship, and only one device per level.
         Cards are separated by air, contents by a rule, rows of one list by a
         hairline. card_gap is sized so a MAJOR's 6dp shadow plus its 3dp edge
         always lands on clean canvas - two cards must never touch.
         card_inset + ledger_inset equals the page gutter (16 + 12 = 28), so a
         tile inside a card lines up with the page edge rather than overhangs it.
         Nothing inside one card is ever card_gap or more apart: if two things
         want that much air, they are two cards. -->
    <dimen name="card_gap">16dp</dimen>
    <dimen name="group_gap">12dp</dimen>
    <dimen name="line_gap">8dp</dimen>
    <dimen name="pair_gap">4dp</dimen>
    <dimen name="card_inset">16dp</dimen>
    <dimen name="ledger_inset">12dp</dimen>

    <!-- Flat radii, from the approved sheet: a card is 28, and a field or a tile
         is 22. Two names on 22 because a field and a tile are different objects
         that happen to share a corner, and `radius_step` stays at 4 for now -
         seven call sites draw chart bars with it, and the bars are geometry work
         (Batch 7), not a token swap. A sixth radius is still not allowed. -->
    <dimen name="radius_card">28dp</dimen>
    <dimen name="radius_field">22dp</dimen>
    <dimen name="radius_tile">22dp</dimen>
    <dimen name="radius_step">4dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <dimen name="touch_min">48dp</dimen>

    <!-- The home-screen card's own measure. The layout and the bitmap painter
         read these two, so the meter is drawn at the size its view will be
         rather than at a second, drifting copy of the number. -->
    <dimen name="widget_inset">18dp</dimen>
    <dimen name="widget_meter_height">20dp</dimen>

    <!-- Sprite sizes are what they say. They used to be multiples of 16dp
         because every sprite was drawn on a 16x16 grid, and AliveDimens.sprite()
         then rounded the result to a whole number of those cells. The flat
         family is curves and the approved render states a legibility ladder of
         24 / 32 / 48 / 72 / 104 px, three of which are not multiples of 16, so
         the rounding is gone - the dp values below are kept as they are, and now
         reach the screen unrounded. -->
    <dimen name="character_size">64dp</dimen>
    <dimen name="character_size_large">96dp</dimen>
    <dimen name="mark_size">48dp</dimen>
    <dimen name="mark_small_size">32dp</dimen>
    <dimen name="nav_icon_size">32dp</dimen>
    <dimen name="step_size">16dp</dimen>
    <dimen name="step_gap">2dp</dimen>
    <dimen name="brand_mark_size">20dp</dimen>

</resources>
